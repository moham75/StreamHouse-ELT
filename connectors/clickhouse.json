{
  "name": "clickhouse-sink-connector",
  "config": {
    "connector.class": "com.clickhouse.kafka.connect.ClickHouseSinkConnector",
    "tasks.max": "1",
    "hostname": "clickhouse",
    "port": "8123",
    "ssl": "false",
    "database": "clickhouse",
    "username": "clickhouse",
    "password": "clickhouse",

    "topics": "cdc.raw.orders,cdc.raw.order_items,cdc.raw.payments,raw.customers,raw.merchants,raw.products,raw.refunds",
    "topic2TableMap": "cdc.raw.orders=orders,cdc.raw.order_items=order_items,cdc.raw.payments=payments,raw.customers=customers,raw.merchants=merchants,raw.products=products,raw.refunds=refunds",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",

    "exactlyOnce": "false",
    "errors.retry.timeout": "60"
  }
}