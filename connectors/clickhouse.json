{
  "name": "clickhouse-sink-connector",
  "config": {
    "connector.class": "com.clickhouse.kafka.connect.ClickHouseSinkConnector",
    "tasks.max": "1",
    "hostname": "clickhouse",
    "port": "8123",
    "ssl": "false",
    "database": "clickhouse",
    "username": "clickhouse",
    "password": "clickhouse",
    "topics": "postgres_server.public.customers,postgres_server.public.merchants,postgres_server.public.products,postgres_server.public.orders,postgres_server.public.order_items,postgres_server.public.payments,postgres_server.public.refunds,postgres_server.public.events",
    "topic2TableMap": "postgres_server.public.customers=customers,postgres_server.public.merchants=merchants,postgres_server.public.products=products,postgres_server.public.orders=orders,postgres_server.public.order_items=order_items,postgres_server.public.payments=payments,postgres_server.public.refunds=refunds,postgres_server.public.events=events",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "transforms": "unwrap",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "exactlyOnce": "false",
    "errors.retry.timeout": "60"
  }
}